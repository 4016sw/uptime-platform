# Copy to .env and change the passwords:  cp .env.example .env
# .env is gitignored. Never commit real secrets.

POSTGRES_USER=uptime
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=uptime

RABBITMQ_USER=uptime
RABBITMQ_PASSWORD=change-me-rabbitmq

# Optional: leave empty and alerts are only logged (dry run).
# Create a bot with @BotFather, then get your chat ID from @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

LOG_LEVEL=INFO
